# ==========================================
# Cấu hình biến môi trường cho Website
# ==========================================

# Port chạy server (mặc định: 8081)
PORT=8081

# Resend API Key để gửi email
RESEND_API_KEY=your_resend_api_key_here

# Đường dẫn file SQLite Database (mặc định sẽ lấy file brain.db cùng thư mục)
# DB_PATH=/root/my-brain/brain.db
